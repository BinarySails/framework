{
  "name": "@binarysails/framework",
  "version": "1.1.1",
  "description": "Binary Sails Framework",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "package.json",
    "tailwind.config.js",
    "postcss.config.js"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": "https://github.com/BinarySails/framework",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts -d build --sourcemap --minify terser",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "lint:check": "eslint src/**/*.tsx",
    "lint:fix": "eslint src/**/*.tsx --fix",
    "publish-packages": "bun run build && changeset version && changeset publish",
    "prepare": "husky"
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.19",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@headlessui/react": "latest",
    "@react-oauth/google": "^0.12.1",
    "axios": "^1.7.2",
    "classnames": "^2.5.1",
    "immer": "^10.1.1",
    "mixpanel-browser": "2.48.1",
    "next": "^14.2.4",
    "react": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-phone-input-2": "^2.15.1",
    "react-remove-scroll": "^2.5.10",
    "rrule": "^2.8.1",
    "swr": "^2.2.5",
    "tailwindcss": "^3.4.4",
    "urlcat": "^3.1.0",
    "use-immer": "^0.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@eslint/js": "^9.6.0",
    "@fortawesome/free-brands-svg-icons": "^6.5.2",
    "@turbo/gen": "^1.13.4",
    "@types/bun": "^1.1.6",
    "@types/mixpanel-browser": "2.47.5",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^9.6.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.4.0",
    "husky": "^9.0.11",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "terser": "^5.31.1",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3"
  }
